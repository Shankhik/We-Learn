    "canvas-confetti": "^1.9.4",
    "cloudinary": "^2.7.0",
    "cookies-next": "^6.1.1",
    "html-react-parser": "^5.2.5",
    "ioredis": "^5.8.2",
    "isomorphic-dompurify": "^3.9.0",
    "jose": "^6.1.3",
    "jsonwebtoken": "^9.0.2",
    "marked": "^17.0.1",
    "mongodb": "^6.21.0",
    "next": "^16.2.12",
    "next-view-transitions": "^0.3.5",
    "nodemailer": "^9.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
