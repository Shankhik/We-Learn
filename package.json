  "private": true,
  "type": "module",
  "scripts": {
    "dev:wb": "tsx --watch web-socket/server.ts",
    "dev:server": "tsx start-server.ts",
    "dev:email": "email dev --port=1000 --dir=src/react-emails/emails",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "comp-up-dev": "docker compose --env-file .env.docker.dev --file docker-compose.dev.yml up",
